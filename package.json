{
  "name": "@apiaberta/service-template",
  "version": "0.1.0",
  "description": "Template for API Aberta data services",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "test": "node --test src/**/*.test.js",
    "build": "echo 'No build step required'",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "mongoose": "^8.0.0",
    "node-cron": "^3.0.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
